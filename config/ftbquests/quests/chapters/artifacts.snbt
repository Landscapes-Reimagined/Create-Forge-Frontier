	order_index: 0
	quest_links: [ ]
	quests: [
		{
			description: [
				"Across the world of &lForge Frontier&r lie powerful relics known as &lArtifacts&r, each infused with unique qualities that enhance your abilities in extraordinary ways. These rare treasures rest within dungeons, ruins, and secret chambers, waiting for explorers bold enough to claim them."
				""
				"From boots that let you glide across water to rings that grant sudden bursts of speed, every artifact offers a distinct advantage on your journey. Unlike traditional gear, artifacts can be worn alongside your normal equipment, making them invaluable companions for any adventurer."
				""
				"{@pagebreak}"
				"Your mission is simple: &lseek out these legendary relics&r, uncover their secrets, and harness their power to expand what is possible. Will you discover a fire-resistant charm deep within a Nether fortress? Or perhaps stumble upon a lucky talisman buried in the heart of a forgotten ruin?"
				""
				"The frontier is filled with hidden wonders—go find them."
			]
			hide_dependency_lines: false
			hide_dependent_lines: true
			hide_until_deps_visible: false
