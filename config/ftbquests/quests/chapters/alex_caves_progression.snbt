	quests: [
		{
			description: [
				"Orbiting a dim, dying star lies the &3Abyssal Chasm&r, a world completely consumed by endless oceans."
				""
				"Far beneath its dark waters lie ancient ruins, forgotten civilizations, and creatures that have adapted to survive where sunlight has never reached. Strange bioluminescent life illuminates the depths, but even these faint lights cannot hide the dangers lurking below."
				""
				"Prepare yourself before entering this world. Water Breathing, Respiration, Night Vision, and reliable underwater mobility will greatly improve your chances of survival."
				""
				"{@pagebreak}"
				"The ocean is vast."
				""
				"The darkness is endless."
				""
				"And something beneath the waves is watching."
				""
				"{image:alexscaves:textures/misc/advancement/abyssal_background.png width:225 height:175 align:center}"
			]
			hide_dependent_lines: true
			icon: {
				Count: 1
				id: "alexscaves:diving_helmet"
