			}]
			title: "&6Roots of Adventure&r"
			x: -8.5d
			y: -7.0d
		}
		{
			dependencies: ["6770F96C1A4490DE"]
			description: [
				"&cThe Nether&r introduces one of the most challenging progression environments in &6Create - Forge Frontier&r. Its terrain, hostile mobs, and unique resource pools require careful preparation and strategic planning."
				""
				"{image:ftb:textures/nether_screenshot.png width:565 height:400 align:center fit:true}"
				"{@pagebreak}"
				""
				"Accessed through &cNether Remastered&r, this dimension features dangerous landscapes shaped by lava flows, hostile mobs such as ghasts and blazes, and structures including fortresses and bastions. These locations contain essential materials and progression items needed for mid-game crafting, brewing, and advanced systems."
				""
				"Your goal extends beyond basic survival. Effective exploration, resource collection, and combat readiness are key to advancing through the challenges found here."
				""
				"{@pagebreak}"
				""
				"Equip yourself properly, maintain awareness of your surroundings, and approach each structure with caution. The Nether plays a pivotal role in your progression—master its hazards to unlock the resources and pathways required for future advancement."
			]
			hide_dependency_lines: true
			icon: "minecraft:netherrack"
			id: "3F3994EDD215FC99"
			rewards: [{
				id: "7449C4C2ED39AD05"
				type: "xp"
				xp: 100
			}]
			shape: "gear"
			size: 3.0d
			subtitle: "Enter the Nether and begin your progression through its hazards and resources. Click for more info!"
			tasks: [
				{
					dimension: "minecraft:the_nether"
					icon: "minecraft:netherrack"
					id: "21AF3C45D5058473"
					type: "dimension"
				}
				{
					advancement: "nether_remastered:seal_of_the_underworld"
					criterion: ""
					id: "3113F877C713EC7E"
