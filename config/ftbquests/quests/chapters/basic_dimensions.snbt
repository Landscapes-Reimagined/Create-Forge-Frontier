					type: "xp_levels"
					xp_levels: 5
				}
			]
			subtitle: "Forge the Rogue Eye and reignite the brilliance of ancient innovation. Click me for more info!."
			tasks: [
				{
					count: 3L
					id: "6A9240F9171C5635"
