					type: "item"
				}
			]
			subtitle: "Defeat the Warden and unlock access to the Otherside. Click for more info!"
			tasks: [{
				id: "310BD6F382F22641"
				item: "deeperdarker:heart_of_the_deep"
				type: "item"
			}]
			title: "&6Conqueror of the Deep&r"
			x: -1.5d
			y: 0.0d
