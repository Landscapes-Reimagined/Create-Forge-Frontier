					type: "item"
				}
				{
					id: "114E30EAAD068DDB"
					type: "xp_levels"
					xp_levels: 5
				}
			]
			subtitle: "Forge the Witch Eye and awaken the forbidden arts of ancient alchemy. Click me for more info!."
			tasks: [
				{
