	quests: [
		{
			description: [
				"It would seem that the meteors containing alien technology missed Earth and hit Mercury instead!"
				""
				"To begin setting up your advanced storage system, make your way to the second hottest planet in the solar system!"
				""
				"Applied Energistics 2 can do many things, but the main features are digital storage, autocrafting, and wireless storage access."
				""
				"{\"text\":\"For more information about the mod that is outside the scope of these quests, consult the in game guide or\",\"extra\":[{\"text\":\" online wiki.\",\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://guide.appliedenergistics.org/1.20.1/\"},\"color\":\"blue\",\"underlined\":true}]}"
			]
