		}
		{
			dependencies: ["53FCF5F16D2BB329"]
			description: [
				"[\"\",{\"text\":\"The Brass Chunk Loader is a serious upgrade. With a configurable range of 1×1, 3×3, or 5×5 chunks, it ensures large-scale automation stays alive across your base, no matter where you are. For more information, see \"},{\"text\":\"Chunk on the Minecraft Wiki\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://minecraft.wiki/w/chunk\"}},{\"text\":\".\\n\\nPower Requirements:\\n\\nSpeed: 256 RPM\\n\\nStress: 4,096 SU\\n\\nA clear upgrade over its Andesite counterpart-this loader keeps much more of your chunks loaded!\"}]"
				""
				"{image:ftb:textures/brass_loader.png width:200 height:122 align:center}"
			]
