		{
			dependencies: ["610FD2C783821A4E"]
			description: [
				"[\"\",{\"text\":\"The Andesite Chunk Loader is your entry-level solution for keeping machines running while you're away. It keeps a 1-chunk radius (a single 16×16 area) constantly loaded, perfect for basic farms or starter contraptions. For more information, see \"},{\"text\":\"Chunk on the Minecraft Wiki\",\"underlined\":true,\"color\":\"blue\",\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://minecraft.wiki/w/chunk\"}},{\"text\":\".\\n\\nAfter you craft it, you'll need to capture a Ghast by right clicking on it with the Chunk Loader in your hand. \\n\\nPower Requirements:\\n\\nSpeed: 64 RPM\\n\\nStress: 1,024 SU\\n\\nMake sure your system can supply consistent power-if it drops, so does your loaded chunk.\"}]"
				""
				"{image:ftb:textures/andesite_loader.png width:200 height:122 align:center}"
			]
			hide_dependency_lines: true
			icon: "create_power_loader:andesite_chunk_loader"
			id: "53FCF5F16D2BB329"
			rewards: [
				{
					count: 2
